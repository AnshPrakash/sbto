<mujoco model="skateboard_adi">
  <!-- Centered articulated skateboard used by the MJLab training assets. -->
  <default>
    <default class="skateboard">
      <joint armature="0"/>
      <default class="skateboard_visual">
        <geom contype="0" conaffinity="0" group="1" mass="0" density="0"/>
      </default>
      <default class="skateboard_collision">
        <geom contype="1" conaffinity="3" group="3" mass="0" density="0"
              condim="4" solimp="0.9 0.95 0.001 0.5 2" solref="0.005 1"/>
      </default>
    </default>
  </default>

  <asset>
    <material name="deck_orange" rgba="0.1 0.1 0.1 1"/>
    <material name="truck_grey" rgba="0.5 0.5 0.5 1"/>
    <material name="wheel_dark" rgba="0.95 0.45 0.08 1"/>
  </asset>

  <worldbody>
    <body name="base_link" childclass="skateboard">
      <freejoint/>
      <inertial pos="0 0 0" mass="1.2" diaginertia="0.012 0.0391667 0.0391667"/>

      <geom class="skateboard_visual" type="box" size="0.30 0.1 0.01"
            material="deck_orange"/>
      <geom name="deck_collision" class="skateboard_collision" type="box"
            size="0.30 0.1 0.01" friction="1.3 0.005 0.0001" priority="1"/>
      <geom class="skateboard_visual" type="cylinder" size="0.1 0.01"
            pos="0.30 0 0" euler="0 -0.349 0" material="deck_orange"/>
      <geom name="nose_collision" class="skateboard_collision" type="cylinder"
            size="0.1 0.01" pos="0.30 0 0" euler="0 -0.349 0"
            friction="1.3 0.005 0.0001" priority="1"/>
      <geom class="skateboard_visual" type="cylinder" size="0.1 0.01"
            pos="-0.30 0 0" euler="0 0.349 0" material="deck_orange"/>
      <geom name="tail_collision" class="skateboard_collision" type="cylinder"
            size="0.1 0.01" pos="-0.30 0 0" euler="0 0.349 0"
            friction="1.3 0.005 0.0001" priority="1"/>

      <body name="tr0" pos="0.20 0 0.04">
        <inertial pos="0 0 -0.07" mass="0.5" diaginertia="0.0001 0.0001 0.0001"/>
        <joint name="trj0" type="hinge" axis="0.7660444431 0 0.6427876097"
               limited="true" range="-0.349 0.349" stiffness="5" damping="0.2"/>
        <geom class="skateboard_visual" type="box" size="0.03 0.025 0.025"
              pos="0 0 -0.07" euler="0 0 1.5708" material="truck_grey"/>
        <geom name="front_truck_collision" class="skateboard_collision" type="box"
              size="0.03 0.025 0.025" pos="0 0 -0.07" euler="0 0 1.5708"
              friction="1.3 0.005 0.0001" priority="1"/>
        <body name="wh0" pos="0 0 -0.1">
          <inertial pos="0 0.08 0" mass="0.2"
                    diaginertia="5.1666667e-05 9e-05 5.1666667e-05"/>
          <joint name="whj0" type="hinge" axis="0 1 0" damping="0.001"/>
          <geom class="skateboard_visual" type="cylinder" size="0.03 0.01"
                pos="0 0.08 0" euler="1.5708 0 0" material="wheel_dark"/>
          <geom name="wheel0_collision" class="skateboard_collision" type="cylinder"
                size="0.03 0.01" pos="0 0.08 0" euler="1.5708 0 0"
                friction="1.3 0.005 0.0001" priority="1"/>
        </body>
        <body name="wh1" pos="0 0 -0.1">
          <inertial pos="0 -0.08 0" mass="0.2"
                    diaginertia="5.1666667e-05 9e-05 5.1666667e-05"/>
          <joint name="whj1" type="hinge" axis="0 1 0" damping="0.001"/>
          <geom class="skateboard_visual" type="cylinder" size="0.03 0.01"
                pos="0 -0.08 0" euler="1.5708 0 0" material="wheel_dark"/>
          <geom name="wheel1_collision" class="skateboard_collision" type="cylinder"
                size="0.03 0.01" pos="0 -0.08 0" euler="1.5708 0 0"
                friction="1.3 0.005 0.0001" priority="1"/>
        </body>
      </body>

      <body name="tr1" pos="-0.20 0 0.04">
        <inertial pos="0 0 -0.07" mass="0.5" diaginertia="0.0001 0.0001 0.0001"/>
        <joint name="trj1" type="hinge" axis="-0.7660444431 0 0.6427876097"
               limited="true" range="-0.349 0.349" stiffness="5" damping="0.2"/>
        <geom class="skateboard_visual" type="box" size="0.03 0.025 0.025"
              pos="0 0 -0.07" euler="0 0 1.5708" material="truck_grey"/>
        <geom name="rear_truck_collision" class="skateboard_collision" type="box"
              size="0.03 0.025 0.025" pos="0 0 -0.07" euler="0 0 1.5708"
              friction="1.3 0.005 0.0001" priority="1"/>
        <body name="wh2" pos="0 0 -0.1">
          <inertial pos="0 0.08 0" mass="0.2"
                    diaginertia="5.1666667e-05 9e-05 5.1666667e-05"/>
          <joint name="whj2" type="hinge" axis="0 1 0" damping="0.001"/>
          <geom class="skateboard_visual" type="cylinder" size="0.03 0.01"
                pos="0 0.08 0" euler="1.5708 0 0" material="wheel_dark"/>
          <geom name="wheel2_collision" class="skateboard_collision" type="cylinder"
                size="0.03 0.01" pos="0 0.08 0" euler="1.5708 0 0"
                friction="1.3 0.005 0.0001" priority="1"/>
        </body>
        <body name="wh3" pos="0 0 -0.1">
          <inertial pos="0 -0.08 0" mass="0.2"
                    diaginertia="5.1666667e-05 9e-05 5.1666667e-05"/>
          <joint name="whj3" type="hinge" axis="0 1 0" damping="0.001"/>
          <geom class="skateboard_visual" type="cylinder" size="0.03 0.01"
                pos="0 -0.08 0" euler="1.5708 0 0" material="wheel_dark"/>
          <geom name="wheel3_collision" class="skateboard_collision" type="cylinder"
                size="0.03 0.01" pos="0 -0.08 0" euler="1.5708 0 0"
                friction="1.3 0.005 0.0001" priority="1"/>
        </body>
      </body>
    </body>
  </worldbody>

  <contact>
    <exclude body1="base_link" body2="tr0"/>
    <exclude body1="base_link" body2="tr1"/>
    <exclude body1="base_link" body2="wh0"/>
    <exclude body1="base_link" body2="wh1"/>
    <exclude body1="base_link" body2="wh2"/>
    <exclude body1="base_link" body2="wh3"/>
    <exclude body1="tr0" body2="tr1"/>
    <exclude body1="tr0" body2="wh2"/>
    <exclude body1="tr0" body2="wh3"/>
    <exclude body1="tr1" body2="wh0"/>
    <exclude body1="tr1" body2="wh1"/>
    <exclude body1="wh0" body2="wh1"/>
    <exclude body1="wh2" body2="wh3"/>
    <exclude body1="wh0" body2="wh2"/>
    <exclude body1="wh0" body2="wh3"/>
    <exclude body1="wh1" body2="wh2"/>
    <exclude body1="wh1" body2="wh3"/>
  </contact>
</mujoco>
